parameter_threshold = c(-4.0),
threshold_type = c('<='),
time_threshold = 2) %>%
mutate(date = as.Date(starttime)) %>%
group_by(date) %>%
summarize(sum = sum(duration)) %>%
rename(Date = date,
`Duration (hrs)` = sum) %>%
kbl(align = "c") %>%
kable_styling(fixed_thead = T) %>%
column_spec(1, border_left = T)
