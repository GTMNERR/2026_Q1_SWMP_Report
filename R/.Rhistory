spatial <- station_info %>%
filter(grepl("gtm",nerr_site_id)) %>%
filter(!grepl("nut", station_code)) %>%
select(station_code, latitude, longitude) %>%
mutate(longitude = as.numeric(longitude))
spatial<- spatial %>%
mutate(longitude = longitude*(-1))
shape_data <- st_read(here::here('data',
'shapefiles',
'qa_4269_GTM_RB_2014_simplified_DLE.shp'))
# spatial %>%
#   leaflet(width = 900) %>%
#   addTiles() %>%
#   addMarkers(clusterOptions = markerClusterOptions(),
#              label = ~htmlEscape(station_code),
#              labelOptions = labelOptions(textsize = "15px")) %>%
#   addPolygons(data = shape_data, weight = 5, col = 'red')
# addWMSTiles(
#   "http://mesonet.agron.iastate.edu/cgi-bin/wms/nexrad/n0r.cgi",
#   layers = "nexrad-n0r-900913",
#   options = WMSTileOptions(format = "image/png", transparent = TRUE),
#   attribution = "Weather data © 2012 IEM Nexrad"
# )
#| label: tbl-low-temp-duration
#| echo: false
#| tbl-cap: "Number of occurrences air temperature recorded at the SWMP Pellicer Creek meteorological was less than or equal to 0 degrees C"
#
#Filter all atemp data to <=0
Freezes<-MET[which(MET$atemp<=0),]
#Create separate date month year columns
Freezes$Month <- format(Freezes$datetimestamp, "%b")
Freezes$Day <- format(Freezes$datetimestamp, "%d")
Freezes$Year <- year(Freezes$datetimestamp)
Freezes$Month_number <- month(Freezes$datetimestamp)
Freezes$Month_Year <- format(Freezes$datetimestamp, "%b %Y")
Freezes$Month_Day_Year <- format(Freezes$datetimestamp, "%b %d %Y")
#Count the number of occurrences where atemp is <=0 in a single year
Yearly_Freezes <- Freezes %>%
group_by(Year) %>%
add_count(Year, name = "YearlyCounts") %>%
ungroup() %>%
select(datetimestamp, Year, YearlyCounts)
#Count the number of monthly freezes where atemp is <=0 in a single year
Monthly_Freezes <- Freezes %>%
group_by(Month_Year) %>%
add_count(Month_Year, name = "MonthlyCounts") %>%
ungroup() %>%
select(datetimestamp, Year, MonthlyCounts)
#Duration of longest freeze
##Convert to date-time and calculate hours
Duration <- Freezes %>%
mutate(
datetime_col = as_datetime(datetimestamp)) %>%
group_by(Date = as_date(datetime_col)) %>%
summarise(duration_hours = as.numeric(difftime(max(datetime_col),
min(datetime_col),
units = "hours"))) #%>%
# mutate(year = year(Date)) %>%
# mutate(month = month(Date)) %>%
# group_by(year) %>%
#   summarise(duration_max = max(duration_hours))
#Count the number of freeze days where atemp is <=0 in a single year
Number_of_Days <- Freezes %>%
group_by(Month_Day_Year) %>%
distinct(Month_Day_Year, .keep_all = TRUE) %>%
add_count(Month_Day_Year, name = "DailyCounts") %>%
ungroup() %>%
add_count(Year, name = "NumberOfDays") %>%
ungroup() %>%
select(datetimestamp, Year, NumberOfDays)
##Number of occurrences and datetimestamp where the daily mean of atemp is <=0
DailyMeanFreeze <- aggreswmp(MET, by='days', params = 'atemp', FUN='mean') %>%
filter(atemp <= 0) %>%
add_count(atemp, name = "Number_of_Daily_Means") %>%
ungroup()
DailyMeanFreeze$Year <- year(DailyMeanFreeze$datetimestamp)
DailyMeanFreeze$Date_of_Daily_Mean <- (DailyMeanFreeze$datetimestamp)
#Join table information
Freeze_Table <- Yearly_Freezes %>%
full_join(Monthly_Freezes) %>%
full_join(Number_of_Days) %>%
full_join(DailyMeanFreeze)
#Extract only the information needed for final table and print final table in report
Filtered_Table <- Freeze_Table %>%
arrange(Year, Number_of_Daily_Means) %>%
distinct(Year, .keep_all = TRUE)  %>%
select(Year, YearlyCounts, NumberOfDays, Number_of_Daily_Means, Date_of_Daily_Mean) %>%
rename(`Number of Occurrences` = YearlyCounts,
`Number of Days` = NumberOfDays,
`Number of Occurrences Daily Mean` = Number_of_Daily_Means,
`Date of Daily Mean` = Date_of_Daily_Mean)
#If you don't want the table to print NAs
# Filtered_Table <- sapply(Filtered_Table, as.character)
# Filtered_Table[is.na(Filtered_Table)] <- ""
# Filtered_Table <- as.data.frame(Filtered_Table)
print(kbl(Filtered_Table, align = "c") %>%
kable_styling(fixed_thead = T, font_size = 12, bootstrap_options = "striped") %>%
row_spec(0, font_size = 12),
column_spec(2:5,7, border_left = T)
)
kbl(Filtered_Table, align = "c") %>%
kable_styling(fixed_thead = T, font_size = 12, bootstrap_options = "striped") %>%
row_spec(0, font_size = 12) %>%
column_spec(2:5,7, border_left = T)
